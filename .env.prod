# ── Production environment ─────────────────────────────────────────────────────
# Use with: docker compose --env-file .env.prod up
# CRITICAL: All secrets must be injected via a secrets manager (e.g., AWS SSM,
# HashiCorp Vault, or GitHub Actions secrets) — never commit real values here.

POSTGRES_DB=warehouse
POSTGRES_USER=mdp
POSTGRES_PASSWORD=${PROD_POSTGRES_PASSWORD}
POSTGRES_PORT=5432

MINIO_ROOT_USER=${PROD_MINIO_USER}
MINIO_ROOT_PASSWORD=${PROD_MINIO_PASSWORD}
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MDP_BUCKET=lakehouse-prod

KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8081

# Production event volume
PRODUCER_EVENTS=1000
PRODUCER_RATE=100

MDP_PROJECT_DIR=${PROD_PROJECT_DIR}

SCHEMA_REGISTRY_PORT=8083

AIRFLOW_PORT=8080
AIRFLOW_USERNAME=${PROD_AIRFLOW_USER}
AIRFLOW_PASSWORD=${PROD_AIRFLOW_PASSWORD}
AIRFLOW_FERNET_KEY=${PROD_FERNET_KEY}

SPARK_THRIFT_PORT=10000

# Full ML training settings
FORECAST_DAYS=30
CHURN_DAYS_THRESHOLD=14
RECOMMENDATION_TOP_N=5
