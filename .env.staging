# ── Staging environment ────────────────────────────────────────────────────────
# Use with: docker compose --env-file .env.staging up
# Production-like settings on non-production infrastructure.
# IMPORTANT: Replace all placeholder passwords before use.

POSTGRES_DB=warehouse
POSTGRES_USER=mdp
POSTGRES_PASSWORD=CHANGE_ME_STAGING
POSTGRES_PORT=5432

MINIO_ROOT_USER=mdp_staging
MINIO_ROOT_PASSWORD=CHANGE_ME_STAGING
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MDP_BUCKET=lakehouse-staging

KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8081

# Realistic batch size for staging validation
PRODUCER_EVENTS=500
PRODUCER_RATE=50

MDP_PROJECT_DIR=.

SCHEMA_REGISTRY_PORT=8083

AIRFLOW_PORT=8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=CHANGE_ME_STAGING
AIRFLOW_FERNET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_CRYPTOGRAPHY

SPARK_THRIFT_PORT=10000

# Full ML training settings
FORECAST_DAYS=30
CHURN_DAYS_THRESHOLD=14
RECOMMENDATION_TOP_N=5
